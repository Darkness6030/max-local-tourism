# Обязательные интеграции
YANDEX_SCHEDULE_API_KEY=
GIGACHAT_CREDENTIALS=

# MAX. В браузере без MAX разрешён только явный локальный режим.
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_ALLOW_LOCAL_AUTH=true
MAX_INIT_DATA_TTL_SECONDS=3600
MAX_JOB_CONCURRENCY=3
# После python scripts/setup_max_ca.py:
MAX_CA_BUNDLE_FILE=

# GigaChat. Для старого корпоративного ключа оставьте CORP.
GIGACHAT_SCOPE=GIGACHAT_API_CORP
GIGACHAT_MODEL=GigaChat-2-Max
GIGACHAT_TIMEOUT_SECONDS=90
# Для production установите корневой сертификат Минцифры и включите проверку.
GIGACHAT_VERIFY_SSL_CERTS=true
GIGACHAT_CA_BUNDLE_FILE=

# auto использует OpenWeatherMap при наличии ключа, иначе Open-Meteo.
WEATHER_PROVIDER=auto
OPENWEATHER_API_KEY=

# Общие настройки
APP_ENV=development
APP_LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=20
NOMINATIM_USER_AGENT=max-local-tourism-mvp/0.1

# PostgreSQL: compose задаёт URL автоматически. Для запуска Python напрямую:
DATABASE_URL=postgresql+asyncpg://tourism:local-tourism@127.0.0.1:5432/tourism

# Секрет входящего MAX webhook; пустое значение отключает обработчик.
MAX_WEBHOOK_SECRET=
# Альтернативный сервер Nominatim, если потребуется смена провайдера.
NOMINATIM_DOMAIN=nominatim.openstreetmap.org

# Free hotel catalog (OpenStreetMap); no room rates or availability.
OVERPASS_API_URL=https://maps.mail.ru/osm/tools/overpass/api/interpreter
